# Keep secrets, local state and build output out of the build context / image.
# Patterns are relative to this directory; `**/` makes them recursive.
# NEXT_PUBLIC_API_URL is passed as a build arg (see Dockerfile), not via .env files.
# Regression test: scripts/test-dockerignore.sh

# --- Secrets (mirrors the root .gitignore) ----------------------------------
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
**/*.pem
**/*.key
**/*.p12
**/*.jks
**/*.keystore
**/google-services.json
**/GoogleService-Info.plist

# --- Local databases ----------------------------------------------------------
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.db-journal

# --- Dependencies and build output -------------------------------------------
**/node_modules
**/.next
**/out
**/coverage
**/*.tsbuildinfo
**/npm-debug.log*

# --- OS / editor ----------------------------------------------------------------
**/.DS_Store
