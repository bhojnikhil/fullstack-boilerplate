# Browser-visible API base URL. Set this at build time for the Docker image.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Legal templates. scripts/customize.sh fills these two placeholders.
# Helpers preserve quotes and backslashes in names generated by customize.sh.
_WEB_APP_NAME_QUOTE='"'
_WEB_APP_NAME_BACKSLASH=\
WEB_LEGAL_APP_NAME="{{APP_NAME}}"
WEB_LEGAL_DOMAIN={{DOMAIN}}

# Public mailbox monitored by the operator for account deletion requests.
WEB_SUPPORT_EMAIL=

# Android App Links. Use comma-separated, colon-delimited SHA-256 fingerprints.
# For Play builds, include the Play App Signing certificate fingerprint.
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_CERT_FINGERPRINTS=

# Apple Universal Links. Use the 10-character Team ID and the app bundle ID.
IOS_TEAM_ID=
IOS_BUNDLE_ID=

# Comma-separated paths handled by the app, including verify/reset/invite paths.
# Supports * wildcards. Unset uses /app/*.
IOS_APPLINK_PATHS=
