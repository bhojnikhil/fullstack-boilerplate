# Build context is the repository root; allowlist only what the web build needs.
# Regression test: scripts/test-dockerignore.sh
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!apps/web
!packages/config

# --- Secrets (mirrors the root .gitignore) ----------------------------------
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
**/*.pem
**/*.key
**/*.p12
**/*.jks
**/*.keystore
**/google-services.json
**/GoogleService-Info.plist

# --- Local databases ----------------------------------------------------------
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.db-journal

# --- Dependencies and build output -------------------------------------------
**/node_modules
**/.next
**/out
**/.turbo
**/coverage
**/playwright-report
**/test-results
**/*.tsbuildinfo
**/next-env.d.ts
**/npm-debug.log*

# --- OS / editor ----------------------------------------------------------------
**/.DS_Store
