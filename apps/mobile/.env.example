# Mobile app build-time configuration, read and validated by app.config.ts.
#
# Copy to apps/mobile/.env for local Expo CLI runs (expo start / expo config
# load it before evaluating app.config.ts). .env is git-ignored; never commit it.
#
# EAS CLI (eas build / update / init / env) does NOT read this file: it uses
# your shell's environment, then EAS environment variables. See the README
# section "EAS builds and updates".
#
# Every value here ends up inside the app binary / update bundle and is
# readable by anyone with the app. Do not put secrets here.

# development | preview | production. Defaults to development for local Expo
# CLI runs; required (no default) whenever EAS evaluates the config.
# Non-production variants get a ".dev" / ".preview" suffix on the Android
# package and iOS bundle id, a "-dev" / "-preview" suffix on the scheme, and a
# "(Dev)" / "(Preview)" name suffix, so all three can be installed side by side.
# The runtime version is 1.0.0-<variant>, so EAS updates never cross variants.
APP_VARIANT=development

# Base URL of the API (no trailing /v1), no credentials, query or fragment.
# Required and https-only for preview and production. Defaults to
# http://localhost:8000 for development. From a device or emulator,
# "localhost" is the device itself:
#   Android emulator: http://10.0.2.2:8000
#   iOS simulator:    http://localhost:8000
#   Physical device:  http://<your computer's LAN IP>:8000
API_URL=http://10.0.2.2:8000

# Display name (default "Boilerplate") and EAS project slug
# (default "fullstack-boilerplate"). scripts/customize.sh fills the {{...}}
# placeholders in this file; run it before copying this file to .env.
APP_NAME="{{DISPLAY_NAME}}"
APP_SLUG={{PROJECT_NAME}}

# Application ids before the variant suffix (default com.example.boilerplate).
# Required for production, where the com.example placeholder is refused
# (Google Play rejects it). They can't change after the first store release.
# Android: letters, digits and "_" per segment. iOS: letters, digits and "-".
ANDROID_PACKAGE={{ANDROID_PACKAGE}}
IOS_BUNDLE_ID={{IOS_BUNDLE_ID}}

# Deep-link URL scheme, e.g. "boilerplate" -> boilerplate://... (default "boilerplate").
APP_SCHEME={{DEEP_LINK_SCHEME}}

# App Links (Android) / universal links (iOS). Off unless BOTH are set.
# APP_DOMAIN: bare host (no https://), e.g. app.example.com. Use different hosts
#   for preview and production so their builds don't compete for the same links.
# APP_LINK_PATHS: comma-separated paths the app claims on that host:
#   "/verify-email" = exactly that path, "/invite/" = whole segments below it.
#   No wildcards. /privacy, /terms, /account-deletion and /.well-known are
#   always refused (they must open on the web). Only list paths the app has
#   screens for. The web app must serve /.well-known/assetlinks.json and
#   /.well-known/apple-app-site-association (with the same paths) for the host.
APP_DOMAIN={{DOMAIN}}
APP_LINK_PATHS=

# EAS project (printed by `eas init`). When set, EAS Update is configured
# (updates.url = https://u.expo.dev/<id>). EXPO_OWNER is the Expo account or
# organization that owns the project.
EAS_PROJECT_ID=
EXPO_OWNER=

# Sentry DSN for the app. Read into the config but not used yet.
SENTRY_DSN=
