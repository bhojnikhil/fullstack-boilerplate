# Mobile app build-time configuration, read by app.config.ts.
#
# Copy to apps/mobile/.env for local development (Expo CLI loads it before
# evaluating app.config.ts). .env is git-ignored; never commit it.
# For EAS builds, APP_VARIANT comes from eas.json and everything else from
# EAS environment variables (`eas env:create`), not from this file.
#
# Every value here ends up inside the app binary / update bundle and is
# readable by anyone with the app. Do not put secrets here.

# development | preview | production. Non-production variants get a ".dev" /
# ".preview" suffix on the Android package and iOS bundle id, a "-dev" /
# "-preview" suffix on the scheme, and a "(Dev)" / "(Preview)" name suffix, so
# all three can be installed side by side.
APP_VARIANT=development

# Base URL of the API (no trailing /v1). Required and https-only for preview and
# production. Defaults to http://localhost:8000 for development. From a device
# or emulator, "localhost" is the device itself:
#   Android emulator: http://10.0.2.2:8000
#   iOS simulator:    http://localhost:8000
#   Physical device:  http://<your computer's LAN IP>:8000
API_URL=http://10.0.2.2:8000

# Display name (default "Boilerplate") and EAS project slug
# (default "fullstack-boilerplate").
APP_NAME=
APP_SLUG=

# Reverse-DNS application ids (default com.example.boilerplate). Changing them
# after release creates a different app in the stores.
ANDROID_PACKAGE=
IOS_BUNDLE_ID=

# Deep-link URL scheme, e.g. "boilerplate" -> boilerplate://... (default "boilerplate").
APP_SCHEME=

# Bare host (no https://) for Android App Links and iOS universal links,
# e.g. app.example.com. Leave empty to disable both. The web app must serve
# /.well-known/assetlinks.json and /.well-known/apple-app-site-association
# for this host.
APP_DOMAIN=

# EAS project (from `eas init`). When set, EAS Update is configured
# (updates.url = https://u.expo.dev/<id>). EXPO_OWNER is the Expo account or
# organization that owns the project.
EAS_PROJECT_ID=
EXPO_OWNER=

# Sentry DSN for the app. Read into the config but not used yet.
SENTRY_DSN=
