# development | test | staging | production. The API defaults to production without ENV.
ENV=development

# Required outside development. Plain postgresql:// or postgresql+psycopg:// uses psycopg 3.
# For Neon, use the pooled endpoint for the app and a direct endpoint for Alembic.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/boilerplate
# Optional. If unset or blank, Alembic uses DATABASE_URL.
MIGRATION_DATABASE_URL=

# Server-side HMAC secret (IP hashes, CSRF tokens, rate-limit and audit identifiers).
# Required outside development (at least 32 characters).
# customize.sh replaces this placeholder in the local .env with openssl rand -hex 32.
SECRET_KEY={{GENERATE_SECRET_KEY}}
# Access-token signing key. Required in staging and production: at least 32 bytes for
# HS256 (48 for HS384, 64 for HS512) and different from SECRET_KEY, e.g.
# openssl rand -hex 32. Leave blank in development/test to derive one from SECRET_KEY.
JWT_SECRET_KEY=
# HS256, HS384 or HS512.
JWT_ALGORITHM=HS256
# Access tokens carry these iss/aud claims and are rejected if they differ.
JWT_ISSUER=boilerplate-api
JWT_AUDIENCE=boilerplate-api
# Access-token lifetime (1-60 minutes).
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Each refresh extends a session by this many days (idle timeout) ...
REFRESH_TOKEN_EXPIRE_DAYS=30
# ... up to this many days after sign-in (absolute lifetime).
SESSION_MAX_AGE_DAYS=90
# Deleting the account, changing the email and (un)linking Google require a sign-in or
# re-authentication on the same session within this many minutes.
REAUTHENTICATION_MAX_AGE_MINUTES=10
# Lifetime of emailed links: email verification and email change (hours), reset (minutes).
EMAIL_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=30
# Reject new passwords found in Have I Been Pwned (k-anonymity: only a SHA-1 prefix is
# sent). Off by default; fails open if the service is unreachable.
PASSWORD_BREACH_CHECK=false

# Product name used in emails, and the web app base URL that emailed links open.
# Staging and production require https.
APP_NAME=Boilerplate App
WEB_URL=http://localhost:3000

# Sign in with Google (ID tokens). When enabled, set at least one OAuth client ID;
# tokens issued to any configured client are accepted.
GOOGLE_AUTH_ENABLED=false
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# console (development: prints messages and links to stdout), smtp, or memory (tests).
# Staging and production require smtp. Compose sends to Mailpit (http://localhost:8025).
EMAIL_BACKEND=console
EMAIL_FROM=Boilerplate App <no-reply@localhost>
SMTP_HOST=localhost
SMTP_PORT=1025
# none, starttls or tls (implicit TLS, usually port 465). Staging and production require
# starttls or tls; credentials always do.
SMTP_SECURITY=none
# Allow SMTP_SECURITY=none in staging/production, for a relay on the same host or
# private network only.
SMTP_ALLOW_INSECURE=false
# Set both or neither.
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=10

# postgres (default; required in staging and production) or memory (single process).
RATE_LIMIT_BACKEND=postgres

# JSON arrays. HTTP(S) origins are lowercased and may include a port. Hosts omit ports.
# Staging and production disallow a catch-all host. The two probes accept any Host.
# CORS_ORIGINS is also the allowlist for the Origin check on web sign-in and refresh.
CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["localhost","127.0.0.1","[::1]"]
# Maximum HTTP request body in bytes (including streamed/chunked requests).
MAX_REQUEST_BODY_BYTES=1048576

# Optional container probe override. healthcheck.py reads the process environment.
# HEALTHCHECK_URL=http://127.0.0.1:8000/health
