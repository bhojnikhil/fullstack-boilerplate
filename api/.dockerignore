# Keep secrets, local state and caches out of the build context / image.
# Patterns are relative to this directory; `**/` makes them recursive.
# Regression test: scripts/test-dockerignore.sh

# --- Secrets (mirrors the root .gitignore) ----------------------------------
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
**/*.pem
**/*.key
**/*.p12
**/*.jks
**/*.keystore
**/google-services.json
**/GoogleService-Info.plist

# --- Local databases ----------------------------------------------------------
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.db-journal

# --- Python virtualenvs, caches and build output -----------------------------
**/.venv
**/venv
**/__pycache__
**/*.py[cod]
**/*.egg-info
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.coverage
**/.coverage.*
**/coverage.xml
**/htmlcov

# --- OS / editor ----------------------------------------------------------------
**/.DS_Store
